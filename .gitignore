# V3.0 regression fixtures are small and MUST be versioned despite the global
# *.npz / *.npy ignores above (they are the bit-identical oracle for the refactor).
!tests/fixtures/
!tests/fixtures/**
!tests/fixtures/**/*.npz
!tests/fixtures/**/*.npy

